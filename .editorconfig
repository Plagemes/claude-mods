# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

# 2-space indentation for code files
[*.{js,jsx,ts,tsx,json,yaml,yml,md}]
indent_style = space
indent_size = 2

# 2-space indentation for shell scripts
[*.{sh,bash}]
indent_style = space
indent_size = 2

# Preserve tabs in Makefiles
[Makefile]
indent_style = tab
